-- TeX label: cor:rooted-vertices
module

public import AsymptoticSubspace.ThmLimitingVertices

/-!
# Limiting convex hulls under k-rooted communication

Formalizes Corollary 22 in Section 5.4. The hypotheses require α-safe weights
and k-rooted graphs at every positive round; the root sets may vary with time.
As in Theorem 21, the result is quantified over arbitrary averaging executions.

The proof groups `L = ⌈((π² + 6) / 6) n + 1⌉` consecutive rounds. The sampled
execution has the original outputs at block boundaries and the corresponding
products of weights. Its broadcasting weight is at least `α ^ L`.
-/

@[expose] public section

noncomputable section

namespace AsymptoticSubspace

open ComputationalModel ModelLemmas Set Filter
open scoped Topology

/-- Every `α`-safe averaging execution in `k`-rooted communication graphs has
a limit hull generated by at most `k` points, with at most `k` vertices.
As in the manuscript, group `L = ⌈((π² + 6) / 6) n + 1⌉` consecutive rounds,
apply `theorem_limiting_vertices` with broadcasting weight `α ^ L`, and use
nestedness to identify the intersection along block boundaries. -/
theorem corollary_rooted_vertices
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [FiniteDimensional ℝ V] {n : ℕ} [NeZero n]
    (k : ℕ) (hk : 1 ≤ k) (hkd : k ≤ Module.finrank ℝ V)
    (E : AveragingExecution (V := V) n) (α : ℝ) (hα : 0 < α)
    (hsafe : AlphaSafeActualRounds E α)
    (hroot : ∀ t, 0 < t → IsKRooted (E.graphs t) k) :
    ∃ X : Finset V, X.Nonempty ∧ X.card ≤ k ∧
      (⋂ t, Poly E t) = convexHull ℝ (X : Set V) ∧
      ((⋂ t, Poly E t).extremePoints ℝ).ncard ≤ k ∧
      Tendsto (fun t => Metric.hausdorffDist (Poly E t) (⋂ s, Poly E s)) atTop (𝓝 0) := by
  classical
  -- 1. Theorem 1 makes every block of L rounds k-broadcastable.
  let L := linearBroadcastRounds n
  have hL : 0 < L := linearBroadcastRounds_pos n
  -- Normalization changes only unused round-zero graph/weight data, not outputs.
  let B := blockExecution E.normalizeRoundZero L
  have hblocks : ∀ t, IsKBroadcastable (B.graphs t) k := fun t =>
    sharpRootedBroadcastBound n k hk E.normalizeRoundZero.graphs
      (normalizeRoundZero_all (f := E.graphs) (P := fun G => IsKRooted G k) hroot)
      ((t - 1) * L)
  choose M hcard hbroadcast using hblocks
  -- 2. Block weights are α^L-safe, hence have minimum broadcasting weight α^L.
  have hmbw : MinimumBroadcastWeight B M (α ^ L) :=
    alphaSafe_implies_minimumBroadcastWeight B M _
      (blockExecution_safe E.normalizeRoundZero hα.le (alphaSafe_normalizeRoundZero E hsafe) L)
      hbroadcast
  have hmbwActual : MinimumBroadcastWeightActualRounds B M (α ^ L) :=
    ⟨fun t _ => hmbw.1 t, fun t _ i => hmbw.2 t i⟩
  obtain ⟨X, hnonempty, hX, hHull, hvertices, _⟩ := theorem_limiting_vertices k hk hkd B M
    (α ^ L) (pow_pos hα L) hmbwActual (fun t _ => hcard t)
  -- 3. B.outputs r = E.outputs (r * L). Nestedness identifies the intersections.
  have hinter : (⋂ r, Poly B r) = ⋂ t, Poly E t := by
    apply Subset.antisymm
    · intro z hz
      apply mem_iInter.mpr
      intro t
      have ht : t ≤ t * L := Nat.le_mul_of_pos_right t hL
      exact ModelLemmas.poly_antitone E ht (mem_iInter.mp hz t)
    · intro z hz
      exact mem_iInter.mpr (fun r => mem_iInter.mp hz (r * L))
  rw [hinter] at hHull hvertices
  exact ⟨X, hnonempty, hX, hHull, hvertices, poly_tendsto_limit E⟩

end AsymptoticSubspace
