-- TeX label: thm:limiting-vertices
module

public import AsymptoticSubspace.LimitingVerticesCore

/-!
# Limiting convex hulls under k-broadcastability

Formalizes Theorem 21 in Section 5.4, "Number of Vertices of the Limit
Polyhedron". `Poly E t` denotes the hull `P(t)` of the process values, and
`Module.finrank ℝ V` is the ambient dimension `d`.

The statement quantifies over arbitrary averaging executions. The hypotheses
on `M` express k-broadcastability and a uniform lower bound on the total
broadcasting weight, at every positive round. They therefore cover every
execution in the oblivious adversaries of the paper.

The conclusion gives a nonempty generating set of at most `k` points, the
vertex bound, and Hausdorff convergence to the intersection. Vertices are
represented by `Set.extremePoints`; their finiteness follows from the finite
convex-hull representation.
-/

@[expose] public section

noncomputable section

namespace AsymptoticSubspace

open ComputationalModel ModelLemmas Filter
open scoped Topology

/-- For `d ≥ k ≥ 1`, the limit hull of an averaging execution with minimum
broadcasting weight `α > 0` is generated by at most `k` points and has at most
`k` vertices. Hypotheses concern only actual communication rounds `t ≥ 1`.

The proof in `LimitingVerticesCore` follows the manuscript: choose a recurring
broadcasting set and convergent configurations, identify the limit hull, apply
Lemma 14 (the decomposition into broadcasting and residual components), and
use extremality to eliminate the residual component. -/
theorem theorem_limiting_vertices
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [FiniteDimensional ℝ V] {n : ℕ} [NeZero n]
    (k : ℕ) (_hk : 1 ≤ k) (_hkd : k ≤ Module.finrank ℝ V)
    (E : AveragingExecution (V := V) n) (M : Round → Finset (Proc n))
    (α : ℝ) (hα : 0 < α)
    (hmbw : MinimumBroadcastWeightActualRounds E M α)
    (hcard : ∀ t, 0 < t → (M t).card ≤ k) :
    ∃ X : Finset V, X.Nonempty ∧ X.card ≤ k ∧
      (⋂ t, Poly E t) = convexHull ℝ (X : Set V) ∧
      ((⋂ t, Poly E t).extremePoints ℝ).ncard ≤ k ∧
      Tendsto (fun t => Metric.hausdorffDist (Poly E t) (⋂ s, Poly E s)) atTop (𝓝 0) := by
  obtain ⟨X, hX, hHull, hvertices⟩ :=
    LimitingVertices.limiting_vertices_core E M k α hα hmbw hcard
  have hnonempty := poly_limit_nonempty E
  rw [hHull, convexHull_nonempty_iff] at hnonempty
  exact ⟨X, hnonempty, hX, hHull, hvertices, poly_tendsto_limit E⟩

end AsymptoticSubspace
